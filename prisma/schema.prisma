// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar_url    String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  // Relations
  accounts                  Account[]
  transactions              Transaction[]
  categories                Category[]
  budgets                   Budget[]
  budget_allocations        BudgetAllocation[]
  debt_accounts             DebtAccount[]
  debt_payments             DebtPayment[]
  sinking_funds             SinkingFund[]
  sinking_fund_contributions SinkingFundContribution[]
  investments               Investment[]
  investment_snapshots      InvestmentSnapshot[]
  monthly_snapshots         MonthlySnapshot[]
  forecast_models           ForecastModel[]
  usage_records             Usage[]
  audit_logs                AuditLog[]

  @@index([email])
  @@index([created_at])
}

// ============================================================================
// ACCOUNTS & TRANSACTIONS
// ============================================================================

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  DEBT
  CREDIT_CARD
}

model Account {
  id              String      @id @default(cuid())
  user_id         String
  name            String
  type            AccountType
  balance         Decimal     @default(0) @db.Decimal(15, 2)
  currency        String      @default("USD")
  description     String?
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  investments     Investment[]

  @@index([user_id])
  @@index([user_id, is_active])
  @@index([created_at])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id              String          @id @default(cuid())
  user_id         String
  account_id      String
  category_id     String?
  amount          Decimal         @db.Decimal(15, 2)
  transaction_type TransactionType
  description     String          @db.VarChar(500)
  transaction_date DateTime
  notes           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [account_id], references: [id], onDelete: Cascade)
  category        Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([account_id])
  @@index([category_id])
  @@index([transaction_date])
  @@index([user_id, transaction_date])
  @@index([user_id, transaction_type])
}

// ============================================================================
// CATEGORIES & BUDGETS
// ============================================================================

model Category {
  id              String      @id @default(cuid())
  user_id         String
  name            String
  description     String?
  color           String      @default("#3B82F6")
  icon            String?
  is_default      Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  budgets         Budget[]

  @@index([user_id])
  @@index([user_id, is_default])
}

enum BudgetTier {
  PROTECTED    // Non-negotiable (housing, insurance, debt payments)
  STRATEGIC    // Important for goals (savings, investments)
  FLEXIBLE     // Discretionary (dining, entertainment)
}

model Budget {
  id              String      @id @default(cuid())
  user_id         String
  category_id     String
  tier            BudgetTier
  monthly_limit   Decimal     @db.Decimal(15, 2)
  alert_threshold Decimal     @default(80) @db.Decimal(5, 2) // Percentage
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category        Category              @relation(fields: [category_id], references: [id], onDelete: Cascade)
  allocations     BudgetAllocation[]

  @@index([user_id])
  @@index([category_id])
  @@index([user_id, tier])
}

model BudgetAllocation {
  id              String      @id @default(cuid())
  user_id         String
  budget_id       String
  year            Int
  month           Int         // 1-12
  allocated       Decimal     @db.Decimal(15, 2)
  spent           Decimal     @default(0) @db.Decimal(15, 2)
  remaining       Decimal     @db.Decimal(15, 2)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  budget          Budget      @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@unique([budget_id, year, month])
  @@index([user_id])
  @@index([budget_id])
  @@index([user_id, year, month])
}

// ============================================================================
// DEBT MANAGEMENT
// ============================================================================

model DebtAccount {
  id              String      @id @default(cuid())
  user_id         String
  name            String      // e.g., "Credit Card", "Car Loan"
  type            String      // CREDIT_CARD, PERSONAL_LOAN, MORTGAGE, etc.
  balance         Decimal     @db.Decimal(15, 2)
  interest_rate   Decimal     @db.Decimal(5, 3)
  min_payment     Decimal?    @db.Decimal(15, 2)
  due_date        Int?        // Day of month
  status          String      @default("ACTIVE") // ACTIVE, PAID_OFF, CLOSED
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payments        DebtPayment[]

  @@index([user_id])
  @@index([user_id, status])
}

model DebtPayment {
  id              String      @id @default(cuid())
  user_id         String
  debt_account_id String
  amount          Decimal     @db.Decimal(15, 2)
  principal       Decimal     @db.Decimal(15, 2)
  interest        Decimal     @db.Decimal(15, 2)
  payment_date    DateTime
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  debt_account    DebtAccount     @relation(fields: [debt_account_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([debt_account_id])
  @@index([payment_date])
}

// ============================================================================
// SINKING FUNDS
// ============================================================================

model SinkingFund {
  id              String      @id @default(cuid())
  user_id         String
  name            String      // e.g., "Emergency Fund", "Car Service"
  description     String?
  target_amount   Decimal     @db.Decimal(15, 2)
  current_amount  Decimal     @default(0) @db.Decimal(15, 2)
  target_date     DateTime?   // When you need the money
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contributions   SinkingFundContribution[]

  @@index([user_id])
  @@index([user_id, target_date])
}

model SinkingFundContribution {
  id              String      @id @default(cuid())
  user_id         String
  fund_id         String
  amount          Decimal     @db.Decimal(15, 2)
  contribution_date DateTime
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  fund            SinkingFund     @relation(fields: [fund_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([fund_id])
  @@index([contribution_date])
}

// ============================================================================
// INVESTMENTS
// ============================================================================

model Investment {
  id              String      @id @default(cuid())
  user_id         String
  account_id      String
  symbol          String      // e.g., "AAPL", "VTSAX"
  name            String      // Full name
  type            String      // STOCK, ETF, UNIT_TRUST, CRYPTO
  quantity        Decimal     @db.Decimal(20, 8)
  purchase_price  Decimal     @db.Decimal(15, 2)
  current_price   Decimal     @db.Decimal(15, 2)
  current_value   Decimal     @db.Decimal(15, 2)
  purchase_date   DateTime
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account         Account                 @relation(fields: [account_id], references: [id], onDelete: Cascade)
  snapshots       InvestmentSnapshot[]

  @@index([user_id])
  @@index([account_id])
  @@index([symbol])
}

model InvestmentSnapshot {
  id              String      @id @default(cuid())
  user_id         String
  investment_id   String
  price           Decimal     @db.Decimal(15, 2)
  quantity        Decimal     @db.Decimal(20, 8)
  value           Decimal     @db.Decimal(15, 2)
  snapshot_date   DateTime
  created_at      DateTime    @default(now())

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investment      Investment      @relation(fields: [investment_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([investment_id])
  @@index([snapshot_date])
}

// ============================================================================
// MONTHLY SNAPSHOTS & FORECASTING
// ============================================================================

model MonthlySnapshot {
  id              String      @id @default(cuid())
  user_id         String
  year            Int
  month           Int         // 1-12
  total_income    Decimal     @default(0) @db.Decimal(15, 2)
  total_expenses  Decimal     @default(0) @db.Decimal(15, 2)
  net_change      Decimal     @db.Decimal(15, 2)
  opening_balance Decimal     @db.Decimal(15, 2)
  closing_balance Decimal     @db.Decimal(15, 2)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, year, month])
  @@index([user_id])
  @@index([year, month])
}

model ForecastModel {
  id              String      @id @default(cuid())
  user_id         String
  name            String      // e.g., "Conservative", "Aggressive"
  description     String?
  monthly_income  Decimal     @db.Decimal(15, 2)
  monthly_expenses Decimal    @db.Decimal(15, 2)
  months_to_forecast Int      @default(12)
  assumptions     String?     // JSON: inflation rate, salary growth, etc.
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ============================================================================
// USAGE & COMPLIANCE
// ============================================================================

model Usage {
  id              String      @id @default(cuid())
  user_id         String
  api_calls       Int         @default(0)
  data_stored_mb  Decimal     @default(0) @db.Decimal(10, 2)
  month           Int         // 1-12
  year            Int
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, year, month])
  @@index([user_id])
}

model AuditLog {
  id              String      @id @default(cuid())
  user_id         String
  action          String      // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity_type     String      // Transaction, Account, etc.
  entity_id       String?
  changes         String?     // JSON diff
  ip_address      String?
  user_agent      String?
  created_at      DateTime    @default(now())

  // Relations
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([user_id, created_at])
}
